# Core
APP_NAME=ProfSchedule AI
ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database — SQLite for local dev, Postgres (Vercel Postgres/Neon/Supabase) in production
DATABASE_URL=sqlite:///./profschedule.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI provider — provider-agnostic, any OpenAI-compatible chat completions endpoint
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_BASE_URL is optional; auto-filled for openai/nvidia/ollama. Set it for
# any other OpenAI-compatible endpoint (vLLM, LM Studio, Groq, etc.)
AI_BASE_URL=

# Reminder cron endpoint protection (set the same value in Vercel Cron config)
CRON_SECRET=change-this-too

# Optional email reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

DEFAULT_TIMEZONE=Asia/Kolkata
