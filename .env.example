# Core
APP_NAME=ProfSchedule AI
ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database — SQLite for local dev, Postgres (Vercel Postgres/Neon/Supabase) in production
DATABASE_URL=sqlite:///./profschedule.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI provider — provider-agnostic, any OpenAI-compatible chat completions endpoint
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# For NVIDIA NIM (AI_PROVIDER=nvidia), use a fast instruct model such as
# meta/llama-3.1-8b-instruct. Large Nemotron *reasoning* models
# (e.g. llama-3.3-nemotron-super-49b-v1) work but take 30s+ per request,
# which is too slow for interactive scheduling.
# AI_BASE_URL is optional; auto-filled for openai/nvidia/ollama. Set it for
# any other OpenAI-compatible endpoint (vLLM, LM Studio, Groq, etc.)
AI_BASE_URL=

# Reminder cron endpoint protection (set the same value in Vercel Cron config)
CRON_SECRET=change-this-too

# Optional email reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

DEFAULT_TIMEZONE=Asia/Kolkata

# --- Supabase Postgres example ---
# Get the password from Supabase → Project Settings → Database.
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.<project-ref>.supabase.co:5432/postgres

# --- Persistent hosts (Render, Railway, VM) ---
# Deliver reminders from an in-process loop instead of an external cron ping.
# Leave false on Vercel/serverless, where background tasks are killed.
ENABLE_BACKGROUND_SCHEDULER=false
REMINDER_POLL_SECONDS=60
