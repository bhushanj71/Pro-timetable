__pycache__/
*.pyc
.env
*.db
.venv/
venv/
.vercel/
node_modules/
.pytest_cache/
*.egg-info/
.DS_Store

# Android signing. A keystore is the identity of the app on Play: anyone
# holding it and its password can publish an update to the listing. It must
# never be committed, and losing it means never updating the listing again.
android/*.keystore
android/*.jks
android/app-release-*.aab
android/app-release-*.apk
android/.bubblewrap/
android/app/
android/build/

# --- Mobile (Capacitor) ---
node_modules/
# Generated native projects. Both are reproducible with `npx cap add`, and
# checking them in means every plugin change arrives as a merge conflict.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
ios/App/Pods/
ios/App/build/
ios/App/App/public/
DerivedData/
*.ipa
*.aab
*.apk
